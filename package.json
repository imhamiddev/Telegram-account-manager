{
  "name": "business-backup-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 migrations apply business_bot --remote",
    "db:migrate:local": "wrangler d1 migrations apply business_bot --local",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "dev:test": "wrangler dev --local --port 8787 --var BOT_TOKEN:123456:TESTTOKEN --var WEBHOOK_SECRET:s3cret --var TG_API:http://127.0.0.1:8788 --test-scheduled",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "wrangler": "^4",
    "jsdom": "^27.0.0"
  }
}
